// MouseStatus 资源脚本（仅图标与版本信息，界面文本全部在源码里）
#include "resource.h"
#include "winres.h"

/////////////////////////////////////////////////////////////////////////////
// Icon
IDI_ICON1               ICON                    "res\\icon.ico"

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,2,0
 PRODUCTVERSION 1,2,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "anye1998"
            VALUE "FileDescription", "MouseStatus Plugin for TrafficMonitor"
            VALUE "FileVersion", "1.2.2.0"
            VALUE "InternalName", "MouseStatus"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "MouseStatus.dll"
            VALUE "ProductName", "MouseStatus"
            VALUE "ProductVersion", "1.2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
